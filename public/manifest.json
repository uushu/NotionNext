{
  "version": 1,
  "basePath": "/pet/utto",
  "states": {
    "idle": {
      "file": "idle.gif",
      "meaning": "默认待机",
      "trigger": "页面加载完成、无特殊状态"
    },
    "reading": {
      "file": "reading.gif",
      "meaning": "阅读文章",
      "trigger": "进入具体 Post，停止滚动 3–5 秒"
    },
    "exploring": {
      "file": "exploring.gif",
      "meaning": "探索分类或标签",
      "trigger": "分类、标签、归档、搜索页面"
    },
    "bored": {
      "file": "bored.gif",
      "meaning": "短时间无操作",
      "trigger": "20–45 秒无鼠标、键盘、滚动或触摸"
    },
    "break": {
      "file": "break.gif",
      "meaning": "休息喝饮料",
      "trigger": "45–90 秒停留或随机挂机事件"
    },
    "sleep": {
      "file": "sleep.gif",
      "meaning": "睡眠",
      "trigger": "120 秒无操作或夜间长时间停留"
    },
    "interact": {
      "file": "interact.gif",
      "meaning": "点击互动或成功反馈",
      "trigger": "单击灵宠、复制成功等"
    },
    "annoyed": {
      "file": "annoyed.gif",
      "meaning": "连续点击或一般错误",
      "trigger": "2 秒内连续点击 4–5 次、轻度请求失败"
    },
    "success": {
      "file": "success.gif",
      "meaning": "完成或庆祝",
      "trigger": "读完文章、分享成功、到达页面底部"
    },
    "fatalError": {
      "file": "fatal-error.webp",
      "fallback": "fatal-error.png",
      "meaning": "404 或严重错误",
      "trigger": "404、数据获取失败、断网"
    }
  },
  "priority": [
    "fatalError",
    "annoyed",
    "success",
    "interact",
    "sleep",
    "reading",
    "exploring",
    "break",
    "bored",
    "idle"
  ]
